{
  "$schema": "https://cmake.org/cmake/help/v4.2/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "include": [
    "./Common.json",
    "./BuildVariant.json",
    "./BuildType.json",
    "./Generators.json",
    "./PlatformLinuxToolchain.json"
  ],
  "configurePresets": [
    {
      "name": "Linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {},
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Linux"
          ]
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "Linux-Clang-Ninja-Debug",
      "inherits": [
        "Common",
        "Linux",
        "Clang",
        "Ninja",
        "Debug"
      ],
      "cacheVariables": {
        "BUILD_SANITIZERS": "address;undefined"
      },
      "environment": {
        "BUILD_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "Linux-Clang-Ninja-ReleaseWithDebugInfo",
      "inherits": [
        "Common",
        "Linux",
        "Clang",
        "Ninja",
        "ReleaseWithDebugInfo"
      ],
      "cacheVariables": {
        "BUILD_SANITIZERS": "address;undefined"
      },
      "environment": {
        "BUILD_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "Linux-Clang-Ninja-Release",
      "inherits": [
        "Common",
        "Linux",
        "Clang",
        "Ninja",
        "Release"
      ]
    },
    {
      "name": "Linux-Gcc-Ninja-Debug",
      "inherits": [
        "Common",
        "Linux",
        "Gcc",
        "Ninja",
        "Debug"
      ],
      "cacheVariables": {
        "BUILD_SANITIZERS": "address;undefined"
      },
      "environment": {
        "BUILD_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "Linux-Gcc-Ninja-ReleaseWithDebugInfo",
      "inherits": [
        "Common",
        "Linux",
        "Gcc",
        "Ninja",
        "ReleaseWithDebugInfo"
      ],
      "cacheVariables": {
        "BUILD_SANITIZERS": "address;undefined"
      },
      "environment": {
        "BUILD_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "Linux-Gcc-Ninja-Release",
      "inherits": [
        "Common",
        "Linux",
        "Gcc",
        "Ninja",
        "Release"
      ]
    },
    {
      "name": "Linux-Clang-NinjaMultiConfig",
      "inherits": [
        "Common",
        "Linux",
        "Clang",
        "NinjaMultiConfig"
      ]
    },
    {
      "name": "Linux-Gcc-NinjaMultiConfig",
      "inherits": [
        "Common",
        "Linux",
        "Gcc",
        "NinjaMultiConfig",
        "Debug"
      ]
    }
  ]
}
