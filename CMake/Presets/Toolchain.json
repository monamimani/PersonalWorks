{
  "$schema": "https://cmake.org/cmake/help/v3.28/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 9,
  "configurePresets": [
    {
      "name": "Msvc",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/toolchain/msvc-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "enableClangTidyCodeAnalysis": true,
          "enableMicrosoftCodeAnalysis": true
        }
      }
    },
    {
      "name": "Clang",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/toolchain/llvm-toolchain.cmake",
      "environment": {
        "CC": "/usr/bin/clang",
        "CCX": "/usr/bin/clang++"
      },
      "cacheVariables": {
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-clang-x64"
        }
      }
    },
    {
      "name": "ClangCl",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/toolchain/llvm-toolchain.cmake",
      "environment": {
        "CC": "clang-cl",
        "CCX": "clang-cl"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CXX_FLAGS": "",
        "CMAKE_C_FLAGS": ""
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "Gcc",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/toolchain/gnu-toolchain.cmake",
      "environment": {
        "CC": "gcc",
        "CCX": "gcc++"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "",
        "CMAKE_C_FLAGS": ""
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x64"
        }
      }
    }
  ]
}
