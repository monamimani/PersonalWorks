vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO KhronosGroup/Vulkan-Headers
    REF "v1.4.331"
    SHA512 9530fc9b50a1a2b24dd19424e9ec61224391c8ec65580316bcb4e3ead326e06cc3d6a70f60e29e3543cd994f8bd592d284633d5f97e524efb5f2e370f1d3d30a
    HEAD_REF main
)

set(VCPKG_BUILD_TYPE release) # header-only port

vcpkg_cmake_configure(SOURCE_PATH "${SOURCE_PATH}"
    OPTIONS
        -DVULKAN_HEADERS_ENABLE_TESTS=OFF
        -DVULKAN_HEADERS_ENABLE_MODULE=ON
        -DVULKAN_HEADERS_ENABLE_MODULE_STD=ON
        -DVULKAN_HEADERS_DISABLE_MODULE_STD=OFF
)
vcpkg_cmake_install()

vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/LICENSE.md")
file(INSTALL "${CMAKE_CURRENT_LIST_DIR}/usage" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}")

