{
  "$schema": "https://cmake.org/cmake/help/v3.28/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 9,
  "configurePresets": [
    {
      "name": "Clang",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/Toolchain/Linux/llvm-toolchain.cmake",
      "environment": {
        "CC": "/usr/bin/clang",
        "CCX": "/usr/bin/clang++"
      },
      "cacheVariables": {
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-clang-x64"
        }
      }
    },
    {
      "name": "Clang-libc++",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/Toolchain/Linux/llvm-libc++-toolchain.cmake",
      "environment": {
        "CC": "/usr/bin/clang",
        "CCX": "/usr/bin/clang++"
      },
      "cacheVariables": {
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-clang-x64"
        }
      }
    },
    {
      "name": "Gcc",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/Toolchain/Linux/gnu-toolchain.cmake",
      "environment": {
        "CC": "gcc",
        "CCX": "gcc++"
      },
      "cacheVariables": {
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x64"
        }
      }
    }
  ]
}
