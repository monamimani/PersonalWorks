{
  "$schema": "https://cmake.org/cmake/help/v3.30/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 9,
  "include": [
    "./Common.json",
    "./BuildVariant.json",
    "./BuildType.json",
    "./Generators.json",
    "./Toolchain.json"
  ],
  "configurePresets": [
    {
      "name": "Linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "Linux-Clang-Ninja-Debug",
      "inherits": [
        "Common",
        "Linux",
        "Clang",
        "Ninja",
        "Debug"
      ]
    },
    {
      "name": "Linux-Clang-Ninja-ReleaseWithDebugInfo",
      "inherits": [
        "Common",
        "Linux",
        "Clang",
        "Ninja",
        "ReleaseWithDebugInfo"
      ]
    },
    {
      "name": "Linux-Clang-Ninja-Release",
      "inherits": [
        "Common",
        "Linux",
        "Clang",
        "Ninja",
        "Release"
      ]
    },
    {
      "name": "Linux-Gcc-Ninja-Debug",
      "inherits": [
        "Common",
        "Linux",
        "Gcc",
        "Ninja",
        "Debug"
      ]
    },
    {
      "name": "Linux-Gcc-Ninja-ReleaseWithDebugInfo",
      "inherits": [
        "Common",
        "Linux",
        "Gcc",
        "Ninja",
        "ReleaseWithDebugInfo"
      ]
    },
    {
      "name": "Linux-Gcc-Ninja-Release",
      "inherits": [
        "Common",
        "Linux",
        "Gcc",
        "Ninja",
        "Release"
      ]
    },
    {
      "name": "Linux-Clang-NinjaMultiConfig-Debug",
      "inherits": [
        "Common",
        "Linux",
        "Clang",
        "NinjaMultiConfig",
        "Debug"
      ]
    },
    {
      "name": "Linux-Gcc-NinjaMultiConfig-Debug",
      "inherits": [
        "Common",
        "Linux",
        "Gcc",
        "NinjaMultiConfig",
        "Debug"
      ]
    }
  ]
}
