{
  "$schema": "https://cmake.org/cmake/help/v4.2/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "configurePresets": [
    {
      "name": "Clang",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/Toolchain/Linux/llvm-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": {
          "type": "FILEPATH",
          "value": "/usr/bin/clang"
        },
        "CMAKE_CXX_COMPILER": {
          "type": "FILEPATH",
          "value": "/usr/bin/clang++"
        },
        "CMAKE_AR": {
          "type": "FILEPATH",
          "value": "/usr/bin/llvm-ar"
        },
        "CMAKE_RANLIB": {
          "type": "FILEPATH",
          "value": "/usr/bin/llvm-ranlib"
        },
        "CMAKE_LINKER": {
          "type": "FILEPATH",
          "value": "/usr/bin/ld.lld"
        }
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
        }
      }
    },
    {
      "name": "Clang-libc++",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/Toolchain/Linux/llvm-libc++-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": {
          "type": "FILEPATH",
          "value": "/usr/bin/clang"
        },
        "CMAKE_CXX_COMPILER": {
          "type": "FILEPATH",
          "value": "/usr/bin/clang++"
        },
        "CMAKE_AR": {
          "type": "FILEPATH",
          "value": "/usr/bin/llvm-ar"
        },
        "CMAKE_RANLIB": {
          "type": "FILEPATH",
          "value": "/usr/bin/llvm-ranlib"
        },
        "CMAKE_LINKER": {
          "type": "FILEPATH",
          "value": "/usr/bin/ld.lld"
        }
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
        }
      }
    },
    {
      "name": "Gcc",
      "hidden": true,
      "toolchainFile": "${sourceDir}/CMake/Toolchain/Linux/gnu-toolchain.cmake",
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      },
      "cacheVariables": {},
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x64"
        }
      }
    }
  ]
}
