{
  "$schema": "https://cmake.org/cmake/help/v4.2/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "include": [
    "./PlatformWindows.configure.json"
  ],
  "buildPresets": [
    {
      "name": "Windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "Windows-Msvc-Ninja-Debug",
      "configurePreset": "Windows-Msvc-Ninja-Debug",
      "inherits": [
        "Windows"
      ]
    },
    {
      "name": "Windows-Msvc-Ninja-ReleaseWithDebugInfo",
      "configurePreset": "Windows-Msvc-Ninja-ReleaseWithDebugInfo",
      "inherits": [
        "Windows"
      ]
    },
    {
      "name": "Windows-Msvc-Ninja-Release",
      "configurePreset": "Windows-Msvc-Ninja-Release",
      "inherits": [
        "Windows"
      ]
    },
    {
      "name": "Windows-ClangCl-Ninja-Debug",
      "configurePreset": "Windows-ClangCl-Ninja-Debug",
      "inherits": [
        "Windows"
      ]
    },
    {
      "name": "Windows-Msvc-NinjaMultiConfig-Debug",
      "configurePreset": "Windows-Msvc-NinjaMultiConfig",
      "configuration": "Debug",
      "inherits": [
        "Windows"
      ]
    },
    {
      "name": "Windows-Msvc-NinjaMultiConfig-ReleaseWithDebugInfo",
      "configurePreset": "Windows-Msvc-NinjaMultiConfig",
      "configuration": "RelWithDebInfo",
      "inherits": [
        "Windows"
      ]
    },
    {
      "name": "Windows-Msvc-VisualStudio-Debug",
      "configurePreset": "Windows-Msvc-VisualStudio",
      "configuration": "Debug",
      "inherits": [
        "Windows"
      ]
    },
    {
      "name": "Windows-Msvc-VisualStudio-ReleaseWithDebugInfo",
      "configurePreset": "Windows-Msvc-VisualStudio",
      "configuration": "RelWithDebInfo",
      "inherits": [
        "Windows"
      ]
    },
    {
      "name": "Windows-Msvc-VisualStudio-Release",
      "configurePreset": "Windows-Msvc-VisualStudio",
      "configuration": "Release",
      "inherits": [
        "Windows"
      ]
    }
  ]
}
